ALTER PROCEDURE [dbo].[CopyCases]

AS
BEGIN

SET NOCOUNT ON

DECLARE	@PROCESS_ID int
DECLARE @RECORDS int
DECLARE @RECORDS_OLD INT
DECLARE @SOURCE NVARCHAR (100) = 'CASES'
DECLARE @DATABASE NVARCHAR (50) = 'MOSAIC' 
DECLARE @SCHEMANAME NVARCHAR(50) = 'dbo'
DECLARE @TABLENAME SYSNAME = 'Cases'
DECLARE @PERCW DECIMAL(14,2) = 1.00
DECLARE @PERCE DECIMAL(14,2) = 5.00

-- INSERT LOG TABLE.
EXEC [dbo].[LogDataInsert] @DATABASE, @SCHEMANAME , @TABLENAME, @RECORDS_OLD OUT, @PROCESS_ID OUT

-- DROP THE TEMP TABLE FIRST IF IT ALREADY EXISTS
IF OBJECT_ID(N'tempdb..#TEMP_CASES') IS NOT NULL
       BEGIN
              DROP TABLE #TEMP_CASES
       END

BEGIN TRY
-- INSERT THE LINKED SERVER TABLE INTO A TEMP TABLE
		SELECT  *
		INTO #TEMP_CASES
		FROM OPENQUERY([SNOWFLAKE_PROD], 
		'SELECT distinct
			ACCESSKEY,
			CONTACT_ID,
			CONTACT_LASTNAME,
			CONTACT_FIRSTNAME,
			CONTACT_SALUTATION,
			CONTACT_MIDDLENAME,
			CONTACT_SUFFIX,
			CONTACT_NAME,
			CONTACT_PHONE,
			CONTACT_MOBILEPHONE,
			CAST(CONTACT_EMAIL AS VARCHAR(1000)) AS CONTACT_EMAIL,
			CONTACT_EMAIL_IS_VALID,
			CONTACT_TITLE,
			CONTACT_DEPARTMENT,
			CONTACT_STATUS,
			CONTACT_PORTALUSER_ID,
			CONTACT_ISACTIVEPORTALUSER,
			CONTACT_DEFAULTACCOUNTROLE,
			CONTACT_LEADSOURCE,
			CONTACT_OWNERID,
			CONTACT_PORTALROLES,
			CONTACT_DONOTEMAIL,
			CONTACT_CONSENT,
			CONTACT_HARD_BOUNCE,
			CONTACT_ISACTIVE,
			CONTACT_CREATEDDATE,
			CONTACT_IS_DEMO,
			ACCOUNT_SALESFORCE_ID,
			ACCOUNT_ERP_NUMBER,
			ACCOUNT_INTER_COMPANY,
			CAST(ACCOUNT_NAME AS VARCHAR(1000)) AS ACCOUNT_NAME,
			ACCOUNT_OWNER_SALESFORCE_ID,
			ACCOUNT_PHARMA_TAGS,
			ACCOUNT_PRIMARY_LOB_1,
			ACCOUNT_PRIMARY_LOB_2,
			ACCOUNT_PRIMARY_LOB_3,
			ACCOUNT_RECORD_TYPE,
			ACCOUNT_STATUS,
			ACCOUNT_SF_CREATEDDATE,
			ACCOUNT_B2B_ONBOARD_DATE,
			CAST(COMPANY_COUNTRYCODE AS VARCHAR(1000)) AS COMPANY_COUNTRYCODE,
			CAST(COMPANY_COUNTRY AS VARCHAR(1000)) AS COMPANY_COUNTRY,
			COMPANY_CURRENCYCODE,
			CAST(COMPANY_DESCRIPTION AS VARCHAR(1000)) AS COMPANY_DESCRIPTION,
			COMPANY_NAME,
			COMPANY_NUMBER,
			CAST(COMPANY_REGION AS VARCHAR(1000)) AS COMPANY_REGION,
			CAST(COMPANY_SEGMENT AS VARCHAR(1000)) AS COMPANY_SEGMENT,
			CAST(COMPANY_SF_CODE AS VARCHAR(1000)) AS COMPANY_SF_CODE,
			ACCOUNT_OWNER_FULL_NAME,
			ACCOUNT_BU_NUMBER,
			ACCOUNT_BU_NAME,
			ACCOUNT_BU_DESCRIPTION,
			ACCOUNT_PARENT_BU_DESCRIPTION,
			CONTACT_OWNER_FULL_NAME,
			ACCOUNT_ALPHANAME,
			CONTACT_INVITE_COUNT,
			CONTACT_CASE_COUNT,
			CONTACT_B2BORDER_COUNT,
			CONTACT_ACTIVITY_COUNT,
			CONTACT_SAMPLE_REQUEST_COUNT,
			CONTACT_QUOTE_REQUEST_COUNT,
			CONTACT_QUOTE_COUNT,
			ACCOUNT_ORDER_COUNT,
			CONTACT_IS_EVER_LOGGED_IN,
			ACTIVE_AND_LOGGEDIN_B2B_USERS,
			CONTACT_PORTAL_STATUS,
			CONTACT_FIRST_INVITE_DATE,
			CONTACT_MYIMCD_JOINED_DATE,
			CONTACT_FIRST_LOGIN_TO_PORTAL_DATE,
			CONTACT_FIRST_PORTAL_REQUEST_DATE,
			CONTACT_MYIMCD_LASTINVITE_DATE,
			CONTACT_LAST_LOGIN_TO_B2B_DATE,
			ACCOUNT_IS_CUSTOMER_PORTAL_ACTIVE,
			ACCOUNT_HAS_SALES,
			ACCOUNT_ACTIVEB2BUSERS,
			USER_ISPORTALENABLED,
			USER_ISACTIVE,
			CONTACT_IS_GENERIC_MAIL,
			CONTACT_IS_DUPLICATE,
			CONTACT_EMAIL_OPT_OUT,
			CONTACT_EMAIL_BOUNCED_REASON,
			AUTOMATIC_ONBOARDING,
			PORTAL_ACTIVATION_BLOCKED,
			ACCOUNT_ABC_RATING,
			SEGMENTATION_CATEGORY,
			ACCOUNT_ABC_CLASSIFICATION,
			CAST(ACCOUNT_CONTACT_ROLE AS VARCHAR(1000)) AS ACCOUNT_CONTACT_ROLE,
			CAST(CONTACT_ACCOUNT_ROLE AS VARCHAR(1000)) AS CONTACT_ACCOUNT_ROLE
		FROM PROD_ENT_DWH_DB.ANALYTICS.CONTACT
		WHERE ACCOUNT_BU_NUMBER LIKE ''4%'' ')			

	-- CREATE TABLE BACKUP
	EXEC [dbo].[CreateTableBackup] @DATABASE, @SCHEMANAME , @TABLENAME

	-- IF THE TEMP TABLE HAS ROWS DROP THE DESTINATION TABLE AND RECREATE THE TEMP TABLE
	IF((SELECT count(*) FROM #TEMP_CASES)>0)
		BEGIN
       
		   -- DROP TABLE IN CASE THE SCHEMA HAS CHANGED AT THE SOURCE
		   DROP TABLE IF EXISTS [MOSAIC].[dbo].[Cases]; 
        
		   -- RECREATE THE DESTINATION TABLE SCHEMA AND DATA
		   SELECT *
		   INTO [MOSAIC].[dbo].[Cases]
		   FROM #TEMP_CASES

		   -- ADD PRIMARY KEY TO THE TABLE
		   --ALTER TABLE [MOSAIC].[dbo].[Opportunity] ALTER COLUMN [QL_NAME] [nvarchar](200) NOT NULL
		   --ALTER TABLE [MOSAIC].[dbo].[Opportunity]
		   -- ADD CONSTRAINT PK_OPPORTUNITY_QlName PRIMARY KEY CLUSTERED ([QL_NAME]);
		 

		END
END TRY
BEGIN CATCH
		UPDATE [Monitor].[LogEtl]
			set END_DATE = CURRENT_TIMESTAMP,
			ERR_MESSAGE = (SELECT  ERROR_MESSAGE()), 
			ERR_LINE = (SELECT  ERROR_LINE()), 
			ERR_PROCEDURE = (SELECT  ERROR_PROCEDURE()), 
			ERR_NUMBER = (SELECT  ERROR_NUMBER()), 
			ERR_SEVERITY = (SELECT  ERROR_SEVERITY()), 
			ERR_STATE = (SELECT  ERROR_STATE()), 
			RECORDS = 0
		where PROCESS_ID = @PROCESS_ID		
		RETURN
END CATCH

	-- UPDATE LOG TABLE.
	EXEC [dbo].[LogDataUpdate] @DATABASE, @SCHEMANAME , @TABLENAME, @RECORDS_OLD,  @PROCESS_ID, @PERCW, @PERCE
	
END

