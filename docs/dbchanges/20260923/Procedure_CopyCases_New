ALTER PROCEDURE [dbo].[CopyCases]

AS
BEGIN

SET NOCOUNT ON

DECLARE	@PROCESS_ID int
DECLARE @RECORDS int
DECLARE @RECORDS_OLD INT
DECLARE @SOURCE NVARCHAR (100) = 'CASES'
DECLARE @DATABASE NVARCHAR (50) = 'MOSAIC' 
DECLARE @SCHEMANAME NVARCHAR(50) = 'dbo'
DECLARE @TABLENAME SYSNAME = 'Cases'
DECLARE @PERCW DECIMAL(14,2) = 1.00
DECLARE @PERCE DECIMAL(14,2) = 5.00

-- INSERT LOG TABLE.
EXEC [dbo].[LogDataInsert] @DATABASE, @SCHEMANAME , @TABLENAME, @RECORDS_OLD OUT, @PROCESS_ID OUT

-- DROP THE TEMP TABLE FIRST IF IT ALREADY EXISTS
IF OBJECT_ID(N'tempdb..#TEMP_CASES') IS NOT NULL
       BEGIN
              DROP TABLE #TEMP_CASES
       END

BEGIN TRY
-- INSERT THE LINKED SERVER TABLE INTO A TEMP TABLE
		SELECT  *
		INTO #TEMP_CASES
		FROM OPENQUERY([SNOWFLAKE_PROD], 
		'SELECT DISTINCT
			CAST(CASE_ID AS VARCHAR(18)) AS CASE_ID,
			CAST(CASE_NUMBER AS VARCHAR(30)) AS CASE_NUMBER,
			CASE_CREATEDDATE,
            CASE_ATTRIBUTED,
			CAST(SALESORDERNUMBER AS VARCHAR(255)) AS SALESORDERNUMBER,
			CASE_DATE_OPENED,
			CASE_CLOSEDDATE,
			CASE_DUE_DATE,
			CASE_ESTIMATED_DATE,
			CASE_PLANNED_RESOLUTION_DATE,
			CASE_LAST_MODIFIED_DATE,
			CAST(PARENT_CASE_ID AS VARCHAR(18)) AS PARENT_CASE_ID,
			CAST(PARENT_CASE_NUMBER AS VARCHAR(30)) AS PARENT_CASE_NUMBER,
			CAST(CASE_STATUS AS VARCHAR(255)) AS CASE_STATUS,
			CAST(CASE_PRIORITY AS VARCHAR(255)) AS CASE_PRIORITY,
			CAST(CASE_TYPE AS VARCHAR(255)) AS CASE_TYPE,
			CAST(CASE_ORIGIN AS VARCHAR(255)) AS CASE_ORIGIN,
			CAST(CASE_REASON AS VARCHAR(255)) AS CASE_REASON,
			CAST(CASE_SUBJECT AS VARCHAR(255)) AS CASE_SUBJECT,
			CAST(LEFT(CASE_DESCRIPTION, 8000) AS VARCHAR(8000)) AS CASE_DESCRIPTION,
			CAST(CASE_RECORD_TYPE AS VARCHAR(8000)) AS CASE_RECORD_TYPE,
			CAST(CASE_CREATED_BY_NAME AS VARCHAR(121)) AS CASE_CREATED_BY_NAME,
			CAST(CASE_LAST_MODIFIED_BY_NAME AS VARCHAR(121)) AS CASE_LAST_MODIFIED_BY_NAME,
			CAST(CASE_OWNERID AS VARCHAR(18)) AS CASE_OWNERID,
			CASE_OWNER_ISACTIVE,
			CASE_ISCLOSED,
			CASE_ESCALATED,
			CASE_DELETED,
			CAST(CASE_DAYS_OPEN AS DECIMAL(10,0)) AS CASE_DAYS_OPEN,
			CAST(CASE_LOB_1 AS VARCHAR(80)) AS CASE_LOB_1,
			CAST(CASE_LOB_2 AS VARCHAR(80)) AS CASE_LOB_2,
			CAST(CASE_LOB_3 AS VARCHAR(80)) AS CASE_LOB_3,
			CAST(CASE_IMCD_COMPANY AS VARCHAR(40)) AS CASE_IMCD_COMPANY,
			CAST(CASE_IMCD_COMPANY_CODE AS VARCHAR(255)) AS CASE_IMCD_COMPANY_CODE,
			CAST(CASE_CONTACT_ID AS VARCHAR(18)) AS CASE_CONTACT_ID,
			CAST(CASE_CONTACT_NAME AS VARCHAR(121)) AS CASE_CONTACT_NAME,
			CAST(CASE_QUANTITY AS DECIMAL(18,4)) AS CASE_QUANTITY,
			CAST(CASE_AFFECTED_QUANTITY AS DECIMAL(18,2)) AS CASE_AFFECTED_QUANTITY,
			CAST(CASE_LOT_NUMBER AS VARCHAR(30)) AS CASE_LOT_NUMBER,
			CAST(CASE_TOTAL_FINANCIAL_IMPACT_EUR AS DECIMAL(38,4)) AS CASE_TOTAL_FINANCIAL_IMPACT_EUR,
			CAST(ACCOUNT_ERP_NUMBER AS VARCHAR(8000)) AS ACCOUNT_ERP_NUMBER,
			CAST(ACCOUNT_NAME AS VARCHAR(8000)) AS ACCOUNT_NAME,
			CAST(ACCOUNT_SALESFORCE_ID AS VARCHAR(8000)) AS ACCOUNT_SALESFORCE_ID,
			CAST(ACCOUNT_STATUS AS VARCHAR(8000)) AS ACCOUNT_STATUS,
			CAST(ACCOUNT_OWNER_NAME AS VARCHAR(121)) AS ACCOUNT_OWNER_NAME,
			CAST(ACCOUNT_BU_NUMBER AS VARCHAR(22)) AS ACCOUNT_BU_NUMBER,
			CAST(ACCOUNT_BU_NAME AS VARCHAR(40)) AS ACCOUNT_BU_NAME,
			CAST(ACCOUNT_PRIMARY_LOB_1 AS VARCHAR(80)) AS ACCOUNT_PRIMARY_LOB_1,
			CAST(ACCOUNT_PRIMARY_LOB_2 AS VARCHAR(80)) AS ACCOUNT_PRIMARY_LOB_2,
			CAST(ACCOUNT_PRIMARY_LOB_3 AS VARCHAR(80)) AS ACCOUNT_PRIMARY_LOB_3,
			CAST(REGIONALACCOUNTNAME AS VARCHAR(8000)) AS REGIONALACCOUNTNAME,
			CAST(GLOBALACCOUNTNAME AS VARCHAR(8000)) AS GLOBALACCOUNTNAME,
			CAST(PRODUCT_NUMBER AS VARCHAR(8000)) AS PRODUCT_NUMBER,
			CAST(PRODUCT_NAME AS VARCHAR(8000)) AS PRODUCT_NAME,
			CAST(PRODUCT_SALESFORCE_ID AS VARCHAR(18)) AS PRODUCT_SALESFORCE_ID,
			CAST(PRODUCT_ITEM_STATUS AS VARCHAR(255)) AS PRODUCT_ITEM_STATUS,
			CAST(PRINCIPAL_NAME AS VARCHAR(8000)) AS PRINCIPAL_NAME,
			CAST(PRINCIPAL_ERP_NUMBER AS VARCHAR(8000)) AS PRINCIPAL_ERP_NUMBER,
			CAST(LOCAL_PRODUCTMANAGER_NAME AS VARCHAR(8000)) AS LOCAL_PRODUCTMANAGER_NAME,
			CAST(LOTNUMBER AS VARCHAR(8000)) AS LOTNUMBER,
			CAST(CASE_INTERCOMPANY_NCR AS VARCHAR(255)) AS CASE_INTERCOMPANY_NCR,
			CAST(DATEDIFF_CASE_CLOSED_AFTER_NCR AS DECIMAL(9,0)) AS DATEDIFF_CASE_CLOSED_AFTER_NCR,
			CAST(IS_NCR_API_CONTROLLED_SUBSTANCE AS VARCHAR(255)) AS IS_NCR_API_CONTROLLED_SUBSTANCE,
			CAST(IS_NCR_RELATED_TO_API AS VARCHAR(255)) AS IS_NCR_RELATED_TO_API,
			CAST(IS_NCR_SPILL_CONSIDERED_SIGNIFICANT AS VARCHAR(255)) AS IS_NCR_SPILL_CONSIDERED_SIGNIFICANT,
			CAST(NCR_ANYPRODUCT_SPILLAGE AS VARCHAR(255)) AS NCR_ANYPRODUCT_SPILLAGE,
			CAST(NCR_ATTRIBUTED_OTHER_DETAILS AS VARCHAR(255)) AS NCR_ATTRIBUTED_OTHER_DETAILS,
			CAST(NCR_CARRIER_ACCOUNT_ALPHANAME AS VARCHAR(8000)) AS NCR_CARRIER_ACCOUNT_ALPHANAME,
			CAST(NCR_CARRIER_ERP_NUMBER AS VARCHAR(8000)) AS NCR_CARRIER_ERP_NUMBER,
			CAST(NCR_CARRIER_ID AS VARCHAR(8000)) AS NCR_CARRIER_ID,
			CAST(NCR_CARRIER_NAME AS VARCHAR(8000)) AS NCR_CARRIER_NAME,
			CAST(NCR_CAUSE AS VARCHAR(255)) AS NCR_CAUSE,
			CAST(NCR_CAUSE_OTHER_DETAILS AS VARCHAR(255)) AS NCR_CAUSE_OTHER_DETAILS,
			CAST(NCR_CREATED_FROM AS VARCHAR(255)) AS NCR_CREATED_FROM,
			CAST(NCR_DAYS_UNFULFILLED_DUETO_INJURY AS DECIMAL(18,0)) AS NCR_DAYS_UNFULFILLED_DUETO_INJURY,
			CAST(NCR_FIRSTAIDPROVIDED_BYIMCD AS VARCHAR(255)) AS NCR_FIRSTAIDPROVIDED_BYIMCD,
			CAST(NCR_INCIDENT_TYPE AS VARCHAR(8000)) AS NCR_INCIDENT_TYPE,
			CAST(NCR_INJURY_OR_ILLNESS_SUFFERED AS VARCHAR(255)) AS NCR_INJURY_OR_ILLNESS_SUFFERED,
			CAST(NCR_ISIMCD_EMPLOYEE_INJURED AS VARCHAR(255)) AS NCR_ISIMCD_EMPLOYEE_INJURED,
			CAST(NCR_MEDICALCARE_PROVIDEDBY_MP AS VARCHAR(255)) AS NCR_MEDICALCARE_PROVIDEDBY_MP,
			CAST(NCR_OVERVIEWOF_CORRECTIVEACTIONS AS VARCHAR(8000)) AS NCR_OVERVIEWOF_CORRECTIVEACTIONS,
			CAST(NCR_ROOT_CAUSE_ANALYSIS AS VARCHAR(8000)) AS NCR_ROOT_CAUSE_ANALYSIS,
			CAST(NCR_SALES_ORDERTYPE AS VARCHAR(8000)) AS NCR_SALES_ORDERTYPE,
			CAST(NCR_SALES_ORDERTYPE_CODE AS VARCHAR(8000)) AS NCR_SALES_ORDERTYPE_CODE,
			CAST(NCR_SHIPMENT_CARRIER_ERP_NUMBER AS VARCHAR(8000)) AS NCR_SHIPMENT_CARRIER_ERP_NUMBER,
			CAST(NCR_SHIPMENT_CARRIER_NAME AS VARCHAR(8000)) AS NCR_SHIPMENT_CARRIER_NAME,
			CAST(NCR_SPILLCLEANED_BYCERTIFIED_WMC AS VARCHAR(255)) AS NCR_SPILLCLEANED_BYCERTIFIED_WMC,
			CAST(NCR_SPILLEDPRODUCT_QUANTITY_KG AS DECIMAL(18,2)) AS NCR_SPILLEDPRODUCT_QUANTITY_KG,
			CAST(NCR_SUMMARY_OF_ACTIONS AS VARCHAR(8000)) AS NCR_SUMMARY_OF_ACTIONS,
			CAST(NCR_SUPPLIER_ACCOUNT_ALPHANAME AS VARCHAR(8000)) AS NCR_SUPPLIER_ACCOUNT_ALPHANAME,
			CAST(NCR_SUPPLIER_ERP_NUMBER AS VARCHAR(8000)) AS NCR_SUPPLIER_ERP_NUMBER,
			CAST(NCR_SUPPLIER_ID AS VARCHAR(8000)) AS NCR_SUPPLIER_ID,
			CAST(NCR_SUPPLIER_NAME AS VARCHAR(8000)) AS NCR_SUPPLIER_NAME,
			CAST(NCR_SUPPLIER_REFERENCE AS VARCHAR(255)) AS NCR_SUPPLIER_REFERENCE,
			CAST(NCR_WAREHOUSE_ACCOUNT_ALPHANAME AS VARCHAR(8000)) AS NCR_WAREHOUSE_ACCOUNT_ALPHANAME,
			CAST(NCR_WAREHOUSE_ERP_NUMBER AS VARCHAR(8000)) AS NCR_WAREHOUSE_ERP_NUMBER,
			CAST(NCR_WAREHOUSE_ID AS VARCHAR(8000)) AS NCR_WAREHOUSE_ID,
			CAST(NCR_WAREHOUSE_NAME AS VARCHAR(8000)) AS NCR_WAREHOUSE_NAME,
			CAST(NCR_WORKINGDAYS_LOST_DUETO_INJURY AS DECIMAL(18,0)) AS NCR_WORKINGDAYS_LOST_DUETO_INJURY,
			IS_NCR_COMPLAINT_CONSIDERED_SIGNIFICANT
		FROM PROD_ENT_DWH_DB.ANALYTICS.CASES
		WHERE ACCOUNT_BU_NUMBER LIKE ''4%'' ')

	-- CREATE TABLE BACKUP
	EXEC [dbo].[CreateTableBackup] @DATABASE, @SCHEMANAME , @TABLENAME

	-- IF THE TEMP TABLE HAS ROWS DROP THE DESTINATION TABLE AND RECREATE THE TEMP TABLE
	IF((SELECT count(*) FROM #TEMP_CASES)>0)
		BEGIN
       
		   -- DROP TABLE IN CASE THE SCHEMA HAS CHANGED AT THE SOURCE
		   DROP TABLE IF EXISTS [MOSAIC].[dbo].[Cases]; 
        
		   -- RECREATE THE DESTINATION TABLE SCHEMA AND DATA
		   SELECT *
		   INTO [MOSAIC].[dbo].[Cases]
		   FROM #TEMP_CASES

		   CREATE NONCLUSTERED INDEX IX_Cases_CaseId
		   ON [MOSAIC].[dbo].[Cases] (CASE_ID)
		   INCLUDE (CASE_NUMBER, CASE_STATUS, ACCOUNT_ERP_NUMBER);

		   CREATE NONCLUSTERED INDEX IX_Cases_CaseNumber
		   ON [MOSAIC].[dbo].[Cases] (CASE_NUMBER)
		   INCLUDE (CASE_ID, CASE_STATUS, CASE_DATE_OPENED);

		   CREATE NONCLUSTERED INDEX IX_Cases_Account
		   ON [MOSAIC].[dbo].[Cases] (ACCOUNT_ERP_NUMBER, CASE_STATUS)
		   INCLUDE (CASE_ID, CASE_NUMBER, CASE_DATE_OPENED);

		   CREATE NONCLUSTERED INDEX IX_Cases_Opened
		   ON [MOSAIC].[dbo].[Cases] (CASE_DATE_OPENED, ACCOUNT_BU_NUMBER)
		   INCLUDE (CASE_ID, CASE_NUMBER, CASE_STATUS);

		   UPDATE STATISTICS [MOSAIC].[dbo].[Cases] WITH FULLSCAN;


		END
END TRY
BEGIN CATCH
		UPDATE [Monitor].[LogEtl]
			set END_DATE = CURRENT_TIMESTAMP,
			ERR_MESSAGE = (SELECT  ERROR_MESSAGE()), 
			ERR_LINE = (SELECT  ERROR_LINE()), 
			ERR_PROCEDURE = (SELECT  ERROR_PROCEDURE()), 
			ERR_NUMBER = (SELECT  ERROR_NUMBER()), 
			ERR_SEVERITY = (SELECT  ERROR_SEVERITY()), 
			ERR_STATE = (SELECT  ERROR_STATE()), 
			RECORDS = 0
		where PROCESS_ID = @PROCESS_ID		
		RETURN
END CATCH

	-- UPDATE LOG TABLE.
	EXEC [dbo].[LogDataUpdate] @DATABASE, @SCHEMANAME , @TABLENAME, @RECORDS_OLD,  @PROCESS_ID, @PERCW, @PERCE
	
END

