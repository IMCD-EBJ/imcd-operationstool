/****************************************************************************************************
PROCEDURE NAME : [OperationsTool].[CreateBranchPlants]

DESCRIPTION:
----------------------------------------------------------------------------------------------
ETL procedure that rebuilds [OPERATIONSTOOL].[dbo].[BranchPlants] as a copy of
[MOSAIC].[dbo].[BranchPlants].

TARGET TABLES:
----------------------------------------------------------------------------------------------
• [MOSAIC].[dbo].[BranchPlants]            → Source.
• [OPERATIONSTOOL].[dbo].[BranchPlants]    → Destination slice.
• [MOSAIC].[Monitor].[LogEtl]                  → ETL execution log.

PARAMETERS:
----------------------------------------------------------------------------------------------
(No input parameters)

Internal variables:
   @DATABASE     NVARCHAR(50)  = 'OPERATIONSTOOL'
   @SCHEMANAME   NVARCHAR(50)  = 'dbo'
   @TABLENAME    SYSNAME       = 'BranchPlants'
   @PERCW        DECIMAL(14,2) = 5.00   → Weekly process weight.
   @PERCE        DECIMAL(14,2) = 10.00  → Standard process weight.

CREATION DATE  : 2026-09-23 
****************************************************************************************************/

CREATE OR ALTER PROCEDURE [OperationsTool].[CreateBranchPlants]
AS
BEGIN

SET NOCOUNT ON

DECLARE @PROCESS_ID int
DECLARE @RECORDS int
DECLARE @RECORDS_OLD INT
DECLARE @DATABASE NVARCHAR(50) = 'OPERATIONSTOOL'
DECLARE @SCHEMANAME NVARCHAR(50) = 'dbo'
DECLARE @TABLENAME SYSNAME = 'BranchPlants'
DECLARE @PERCW DECIMAL(14,2) = 5.00
DECLARE @PERCE DECIMAL(14,2) = 10.00

EXEC [MOSAIC].[MANAGEMENT].[LogDataInsert] @DATABASE, @SCHEMANAME, @TABLENAME, @RECORDS_OLD OUT, @PROCESS_ID OUT

BEGIN TRY
        DROP TABLE IF EXISTS [OPERATIONSTOOL].[dbo].[BranchPlants];

        SELECT *
        INTO [OPERATIONSTOOL].[dbo].[BranchPlants]
        FROM MOSAIC.dbo.BranchPlants

END TRY
BEGIN CATCH
    UPDATE [Monitor].[LogEtl]
        SET END_DATE = CURRENT_TIMESTAMP,
            ERR_MESSAGE = (SELECT ERROR_MESSAGE()),
            ERR_LINE = (SELECT ERROR_LINE()),
            ERR_PROCEDURE = (SELECT ERROR_PROCEDURE()),
            ERR_NUMBER = (SELECT ERROR_NUMBER()),
            ERR_SEVERITY = (SELECT ERROR_SEVERITY()),
            ERR_STATE = (SELECT ERROR_STATE()),
            RECORDS = 0
        WHERE PROCESS_ID = @PROCESS_ID
    RETURN
END CATCH

EXEC [MOSAIC].[MANAGEMENT].[LogDataUpdate] @DATABASE, @SCHEMANAME, @TABLENAME, @RECORDS_OLD, @PROCESS_ID, @PERCW, @PERCE

END
GO
