/*
    Carrier Excel import.
    Run Procedure_ExcelImport first (catalog tables and staging procedures).
    The workbook is loaded by imcd-platform-lib into a staging table.
    RC_StoreName dbo.Carrier_Import_Validate checks the staging rows.
    dbo.Carrier_Imported_Data_Load copies those rows into Carrier_Imported_Data
    and adds the import id, import date, user, and branch plant.
    dbo.Configuration_AlertMessage holds the fixed texts shown on the page.
*/

IF OBJECT_ID(N'dbo.Carrier_Imported_Data', N'U') IS NULL
BEGIN
    CREATE TABLE dbo.Carrier_Imported_Data
    (
        ID                INT IDENTITY(1,1) NOT NULL,
        Import_Id         INT               NOT NULL,
        Import_Date       DATETIME          NOT NULL,
        UOT_LocalADUser   NVARCHAR(200)     NULL,
        UOT_Mail          NVARCHAR(200)     NULL,
        UOT_UserName      NVARCHAR(200)     NULL,
        BRP_Id            INT               NOT NULL,
        Carrier_Code      NVARCHAR(255)     NULL,
        Pick_Number       NVARCHAR(255)     NULL,
        Status            NVARCHAR(255)     NULL,
        SKU               NVARCHAR(255)     NULL,
        Delivery_Date     DATETIME          NULL,
        Client            NVARCHAR(255)     NULL,
        Locality          NVARCHAR(255)     NULL,
        Address           NVARCHAR(255)     NULL,
        Country           NVARCHAR(255)     NULL,
        Postal_Code       NVARCHAR(255)     NULL,
        CONSTRAINT PK_Carrier_Imported_Data PRIMARY KEY CLUSTERED (ID)
    );
END
GO

IF NOT EXISTS (SELECT 1 FROM dbo.ReportCatalogImport WHERE RC_ReportType = N'CARRIER')
BEGIN
    INSERT INTO dbo.ReportCatalogImport
        (RC_ReportName, RC_SheetData, RC_TableName, RC_StoreName, RC_ReportType)
    VALUES
        (N'Carrier import', 0, N'Carrier_Import', N'dbo.Carrier_Import_Validate', N'CARRIER');
END
GO

DECLARE @reportId INT = (SELECT RC_ReportId FROM dbo.ReportCatalogImport WHERE RC_ReportType = N'CARRIER');

IF NOT EXISTS (SELECT 1 FROM dbo.ObjectExcelFieldsImport WHERE ObjectId = @reportId)
BEGIN
    INSERT INTO dbo.ObjectExcelFieldsImport (ObjectId, ColumnId, ColumnLabel, ColumnType, ColumnExpression)
    VALUES
        (@reportId, 1,  N'Carrier Code', N'string', N'[Carrier_Code]'),
        (@reportId, 2,  N'Pick Number',  N'string', N'[Pick_Number]'),
        (@reportId, 3,  N'Status',       N'string', N'[Status]'),
        (@reportId, 4,  N'SKU',          N'string', N'[SKU]'),
        (@reportId, 5,  N'Delivery Date',N'date',   N'[Delivery_Date]'),
        (@reportId, 6,  N'Client',       N'string', N'[Client]'),
        (@reportId, 7,  N'Address',      N'string', N'[Address]'),
        (@reportId, 8,  N'Locality',     N'string', N'[Locality]'),
        (@reportId, 9,  N'Postal Code',  N'string', N'[Postal_Code]'),
        (@reportId, 10, N'Country',      N'string', N'[Country]');
END

UPDATE dbo.ObjectExcelFieldsImport
SET ColumnLabel = N'Postal Code'
WHERE ObjectId = @reportId
  AND ColumnLabel = N'Postal code';

UPDATE dbo.ObjectExcelFieldsImport
SET ColumnId = CASE ColumnLabel
    WHEN N'Address' THEN 7
    WHEN N'Locality' THEN 8
    WHEN N'Postal Code' THEN 9
    WHEN N'Country' THEN 10
    ELSE ColumnId
END
WHERE ObjectId = @reportId
  AND ColumnLabel IN (N'Address', N'Locality', N'Postal Code', N'Country');
GO

