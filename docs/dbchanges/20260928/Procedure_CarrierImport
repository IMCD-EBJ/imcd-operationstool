IF OBJECT_ID(N'dbo.Configuration_AlertMessage', N'U') IS NULL
BEGIN
    CREATE TABLE dbo.Configuration_AlertMessage
    (
        CAM_IdMessage  NVARCHAR(100)  NOT NULL,
        CAM_Title      NVARCHAR(200)  NULL,
        CAM_Body       NVARCHAR(MAX)  NULL,
        CAM_Icon       NVARCHAR(50)   NULL,
        CAM_Buttons    NVARCHAR(50)   NULL,
        CAM_Button1    NVARCHAR(100)  NULL,
        CAM_Button2    NVARCHAR(100)  NULL,
        CAM_DangerMode NVARCHAR(10)   NULL,
        CAM_Type       NVARCHAR(50)   NULL,
        CONSTRAINT PK_Configuration_AlertMessage PRIMARY KEY CLUSTERED (CAM_IdMessage)
    );
END
GO

MERGE dbo.Configuration_AlertMessage AS target
USING (VALUES
    (N'CARRIER_BRANCH_REQUIRED', N'Branch plant required', N'Select a branch plant before uploading.', N'danger', NULL, NULL, NULL, NULL, N'Error'),
    (N'CARRIER_BRANCH_LOAD', N'Branch plants', N'Branch plants could not be loaded.', N'danger', NULL, NULL, NULL, NULL, N'Error'),
    (N'CARRIER_UPLOADING', N'Uploading', N'The file is being imported.', N'info', NULL, NULL, NULL, NULL, N'Info'),
    (N'CARRIER_UPLOAD_OK', N'Upload complete', N'Import {importId} stored {rowCount} row(s).', N'success', NULL, NULL, NULL, NULL, N'Success'),
    (N'CARRIER_UPLOAD_ERROR', N'Upload error', N'{detail}', N'danger', NULL, NULL, NULL, NULL, N'Error'),
    (N'CARRIER_COLUMNS', N'Required columns', N'Columns must appear in this exact order and with the correct headers (case-sensitive). If the file does not meet this format, it will not be processed.', N'warning', NULL, NULL, NULL, NULL, N'Warning')
) AS source (CAM_IdMessage, CAM_Title, CAM_Body, CAM_Icon, CAM_Buttons, CAM_Button1, CAM_Button2, CAM_DangerMode, CAM_Type)
ON target.CAM_IdMessage = source.CAM_IdMessage
WHEN MATCHED THEN
    UPDATE SET
        CAM_Title = source.CAM_Title,
        CAM_Body = source.CAM_Body,
        CAM_Icon = source.CAM_Icon,
        CAM_Buttons = source.CAM_Buttons,
        CAM_Button1 = source.CAM_Button1,
        CAM_Button2 = source.CAM_Button2,
        CAM_DangerMode = source.CAM_DangerMode,
        CAM_Type = source.CAM_Type
WHEN NOT MATCHED THEN
    INSERT (CAM_IdMessage, CAM_Title, CAM_Body, CAM_Icon, CAM_Buttons, CAM_Button1, CAM_Button2, CAM_DangerMode, CAM_Type)
    VALUES (source.CAM_IdMessage, source.CAM_Title, source.CAM_Body, source.CAM_Icon, source.CAM_Buttons, source.CAM_Button1, source.CAM_Button2, source.CAM_DangerMode, source.CAM_Type);
GO

