CREATE OR ALTER PROCEDURE [dbo].[Carrier_Imported_Data_Load]
    @tableName     sysname,
    @brpId         int,
    @localAdUser   nvarchar(200),
    @mail          nvarchar(200),
    @userName      nvarchar(200),
    @errorMessage  nvarchar(max) OUTPUT,
    @importId      int OUTPUT,
    @rowCount      int OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    SET @importId = NULL;
    SET @rowCount = 0;
    SET @errorMessage = N'OK';

    IF @tableName IS NULL
        OR @tableName = N''
        OR @tableName LIKE N'%[^A-Za-z0-9_]%'
    BEGIN
        SET @errorMessage = N'ERROR: The uploaded file could not be saved.';
        RETURN;
    END

    IF OBJECT_ID(N'dbo.' + @tableName, N'U') IS NULL
    BEGIN
        SET @errorMessage = N'ERROR: The uploaded file could not be saved.';
        RETURN;
    END

    IF NOT EXISTS (SELECT 1 FROM dbo.BranchPlants WHERE BRP_Id = @brpId)
    BEGIN
        SET @errorMessage = N'ERROR: The selected branch plant was not found.';
        RETURN;
    END

    DECLARE @nextId int = ISNULL((SELECT MAX(Import_Id) FROM dbo.Carrier_Imported_Data), 0) + 1;
    DECLARE @importedAt datetime = GETDATE();
    DECLARE @sql nvarchar(max) = N'
        INSERT INTO dbo.Carrier_Imported_Data
            (Import_Id, Import_Date, UOT_LocalADUser, UOT_Mail, UOT_UserName, BRP_Id,
             Carrier_Code, Pick_Number, Status, SKU, Delivery_Date, Client, Locality, Address, Country, Postal_Code)
        SELECT
            @nextId, @importedAt, @localAdUser, @mail, @userName, @brpId,
            Carrier_Code, Pick_Number, Status, SKU, Delivery_Date, Client, Locality, Address, Country, Postal_Code
        FROM dbo.' + QUOTENAME(@tableName) + N';
        SET @inserted = @@ROWCOUNT;';

    DECLARE @inserted int;
    EXEC sys.sp_executesql
        @sql,
        N'@nextId int, @importedAt datetime, @localAdUser nvarchar(200), @mail nvarchar(200), @userName nvarchar(200), @brpId int, @inserted int OUTPUT',
        @nextId = @nextId,
        @importedAt = @importedAt,
        @localAdUser = @localAdUser,
        @mail = @mail,
        @userName = @userName,
        @brpId = @brpId,
        @inserted = @inserted OUTPUT;

    SET @rowCount = ISNULL(@inserted, 0);
    SET @importId = CASE WHEN @rowCount > 0 THEN @nextId ELSE NULL END;
    SET @errorMessage = N'OK';
END
GO

CREATE OR ALTER PROCEDURE [dbo].[Carrier_Import_Validate]
    @tableName    sysname,
    @errorMessage nvarchar(max) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    SET @errorMessage = N'OK';

    IF @tableName IS NULL
        OR @tableName = N''
        OR @tableName LIKE N'%[^A-Za-z0-9_]%'
        OR OBJECT_ID(N'dbo.' + @tableName, N'U') IS NULL
    BEGIN
        SET @errorMessage = N'ERROR: The uploaded file could not be checked.';
        RETURN;
    END

    DECLARE @conflicts nvarchar(max);
    DECLARE @sql nvarchar(max) = N'
        SELECT @conflicts = STRING_AGG(detail, N''; '')
        FROM (
            SELECT TOP (5)
                N''Pick Number '' + COALESCE(NULLIF(LTRIM(RTRIM(Pick_Number)), N''''), N''(blank)'')
                + N'' and SKU '' + COALESCE(NULLIF(LTRIM(RTRIM(SKU)), N''''), N''(blank)'') AS detail
            FROM dbo.' + QUOTENAME(@tableName) + N'
            GROUP BY Pick_Number, SKU
            HAVING COUNT(DISTINCT ISNULL(CONVERT(varchar(10), Delivery_Date, 23), N''NO DATE'')) > 1
        ) conflicts;';

    EXEC sys.sp_executesql
        @sql,
        N'@conflicts nvarchar(max) OUTPUT',
        @conflicts = @conflicts OUTPUT;

    IF @conflicts IS NOT NULL AND @conflicts <> N''
    BEGIN
        SET @errorMessage = N'ERROR: Each pick number and SKU must have a single delivery date. These do not: '
            + @conflicts + N'.';
        RETURN;
    END

    IF OBJECT_ID(N'dbo.Carrier_Imported_Data', N'U') IS NULL
    BEGIN
        RETURN;
    END

    DECLARE @already nvarchar(max);
    SET @sql = N'
        SELECT @already = STRING_AGG(detail, N''; '')
        FROM (
            SELECT TOP (5)
                N''Pick Number '' + COALESCE(NULLIF(LTRIM(RTRIM(s.Pick_Number)), N''''), N''(blank)'')
                + N'' and SKU '' + COALESCE(NULLIF(LTRIM(RTRIM(s.SKU)), N''''), N''(blank)'')
                + N'' on '' + ISNULL(CONVERT(varchar(10), MIN(s.Delivery_Date), 105), N''(no date)'') AS detail
            FROM dbo.' + QUOTENAME(@tableName) + N' AS s
            INNER JOIN dbo.Carrier_Imported_Data AS stored
                ON stored.Pick_Number = s.Pick_Number
               AND stored.SKU = s.SKU
               AND ISNULL(CONVERT(varchar(10), stored.Delivery_Date, 23), N''NO DATE'')
                 = ISNULL(CONVERT(varchar(10), s.Delivery_Date, 23), N''NO DATE'')
            GROUP BY s.Pick_Number, s.SKU
        ) already;';

    EXEC sys.sp_executesql
        @sql,
        N'@already nvarchar(max) OUTPUT',
        @already = @already OUTPUT;

    IF @already IS NOT NULL AND @already <> N''
    BEGIN
        SET @errorMessage = N'ERROR: These pick numbers and SKUs were already imported with the same delivery date: '
            + @already + N'.';
    END
END
GO

UPDATE dbo.ReportCatalogImport
SET RC_StoreName = N'dbo.Carrier_Import_Validate'
WHERE RC_ReportType = N'CARRIER';
